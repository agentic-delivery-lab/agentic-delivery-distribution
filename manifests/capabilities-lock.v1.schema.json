{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-distribution/blob/main/manifests/capabilities-lock.v1.schema.json",
  "title": "Agentic Delivery capabilities lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "primitiveRepository", "primitiveRelease", "sourceCommit", "contentSha256", "capabilityPolicyVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["draft", "released", "withdrawn"] },
    "primitiveRepository": { "const": "agentic-delivery-lab/agentic-delivery-primitives" },
    "primitiveRelease": { "type": "string", "pattern": "^urn:agentic-delivery:primitive-release:\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capabilityPolicyVersion": { "type": "string", "minLength": 1 }
  }
}
