{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agentic-delivery-lab/agentic-delivery-distribution/blob/main/manifests/consumer-distribution-lock.v1.schema.json",
  "title": "Agentic Delivery consumer distribution lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "bundleVersion", "status", "controlPlane", "architecture", "workflowSource", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "bundleVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "released", "withdrawn"] },
    "controlPlane": { "$ref": "#/$defs/source" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "workflowSource": { "$ref": "#/$defs/source" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "mode", "sourceSha256"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["managed", "generated"] },
          "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contracts": { "type": "object" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "contentSha256", "affectedIdentifiers"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "affectedIdentifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
