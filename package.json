{
  "name": "@agentic-delivery/distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "distribution:check": "node tools/validate-distribution.mjs",
    "bootstrap:plan": "node bootstrap/src/bootstrap.mjs --plan",
    "bootstrap:apply": "node bootstrap/src/bootstrap.mjs --apply",
    "agents:promote:plan": "node bootstrap/src/promote-agent-projections.mjs --plan",
    "agents:promote": "node bootstrap/src/promote-agent-projections.mjs --apply",
    "test": "node --test \"tests/**/*.test.mjs\""
  }
}
